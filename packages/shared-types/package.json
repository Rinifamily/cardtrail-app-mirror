{
  "name": "@cardtrail/shared-types",
  "version": "0.1.0",
  "description": "Shared types and schemas for CardTrail local storage",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./local-storage": {
      "types": "./src/local-storage.ts",
      "default": "./src/local-storage.ts"
    }
  },
  "scripts": {
    "build": "echo 'No build needed - using TypeScript source directly'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.0.15"
  }
}
